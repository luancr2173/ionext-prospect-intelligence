# ---------------------------------------------------------------- Banco (Central + Motor 01)
# Supabase > Project Settings > Database > Connection string > "Session pooler" (porta 5432)
DATABASE_URL=postgresql://postgres.chqvbhodmcxdttfxvwpm:SENHA@HOST-DO-POOLER:5432/postgres

# ---------------------------------------------------------------- Central
# Chaves de máquina (nome:segredo, separadas por vírgula). Gere cada segredo com: openssl rand -hex 32
CENTRAL_API_KEYS=motor-prospecting:TROQUE,motor-audit:TROQUE,neo-n8n:TROQUE
PORT=3333

# ---------------------------------------------------------------- Motor 01
CENTRAL_URL=http://central:3333
# Mesmo segredo de "motor-prospecting" em CENTRAL_API_KEYS
CENTRAL_API_KEY=TROQUE

# Busca web gratuita (opcional; sem chave, tudo vai para a varredura do Claude)
# Tavily: https://app.tavily.com — 1.000 créditos/mês grátis, sem cartão
TAVILY_API_KEY=
TAVILY_LIMITE_MENSAL=950
# Exa: https://exa.ai — crédito mensal grátis, sem cartão. Ajuste o limite ao preço vigente do tipo de busca.
EXA_API_KEY=
EXA_LIMITE_MENSAL=1300
EXA_TIPO=auto

# Só gasta busca web com leads de score estimado >= este valor
SCORE_MINIMO_BUSCA_WEB=45
DIAS_REPROCESSAMENTO=30
CONCORRENCIA=4
USER_AGENT=IONEXT-ProspectIntelligence/0.1 (+https://ionext.com.br)
